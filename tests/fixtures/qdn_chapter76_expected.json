{
  "source": "User-supplied full-page browser screenshot, chapter 76; manually transcribed, whitespace normalized",
  "paragraphs": [
    "\u6d1b\u7384\u9752\u5750\u6b63\u51e0\u5206\uff0c\u8fd8\u7f55\u89c1\u62ac\u8d77\u8896\u5b50\uff0c\u906e\u4f4f\u4e86\u74dc\u74dc\uff0c\u76ee\u5149\u4e5f\u5de6\u53f3\u5ffd\u95ea\uff1a",
    "\u201c\u4f60\u2026\u2026\u55ef\u2026\u2026\u201d",
    "\u53f6\u884c\u6b4c\u786e\u5b9e\u6ca1\u6599\u5230\u80fd\u76f4\u63a5\u8fdb\u699c\uff0c\u77a7\u89c1\u6d1b\u5927\u7f8e\u4eba\u5c40\u4fc3\u6a21\u6837\uff0c\u4ed6\u81ea\u7136\u660e\u767d\u62c5\u5fc3\u4ec0\u4e48\uff0c\u56de\u5230\u69bb\u524d\u7aef\u8d77\u8336\u676f\uff1a",
    "\u201c\u597d\u5566\uff0c\u6211\u90fd\u6ca1\u51fa\u53bb\u6253\u67b6\uff0c\u8d4c\u7ea6\u82e5\u7b97\u6570\uff0c\u5c31\u6b3a\u8d1f\u6d1b\u59d0\u59d0\u4e86\uff0c\u8981\u4e0d\u6539\u4e00\u4e0b\uff0c\u4e03\u5929\u5185\uff0c\u6211\u51b2\u8fdb\u524d\u4e09\u767e\uff1f\u201d",
    "\u6d1b\u7384\u9752\u5b9e\u5728\u62c5\u5fc3\u8fd9\u5c0f\u5b50\u7406\u76f4\u6c14\u58ee\u8981\u8d4c\u6ce8\u3002",
    "\u4f46\u6253\u8d4c\u5c31\u662f\u6253\u8d4c\uff0c\u53f6\u884c\u6b4c\u4e0d\u6253\u67b6\uff0c\u90a3\u6628\u665a\u7761\u89c9\u4e0d\u4e5f\u5728\u7f13\u6162\u6210\u957f\uff1f",
    "\u5f7c\u6b64\u53ea\u8d4c\u4e24\u5929\u8fdb\u4e09\u7532\uff0c\u53c8\u6ca1\u8d4c\u600e\u4e48\u4e0a\u53bb\uff0c\u5979\u8fd8\u5404\u79cd\u52a0\u7801\uff0c\u628a\u6761\u4ef6\u8bbe\u7f6e\u7684\u5982\u6b64\u82db\u523b\u3002",
    "\u5982\u679c\u8fd9\u8fd8\u8f93\u4e0d\u8d77\uff0c\u5f80\u540e\u8fd8\u5982\u4f55\u633a\u8d77\u74dc\u74dc\u5f53\u4e3b\u5b98\uff1f",
    "\u4e3a\u6b64\u6d1b\u7384\u9752\u6c89\u9ed8\u7247\u523b\u540e\uff0c\u5c31\u6162\u6761\u65af\u7406\u7ee7\u7eed\u6ce1\u8336\uff1a",
    "\u201c\u672c\u5b98\u4ec0\u4e48\u8eab\u4efd\uff0c\u9700\u8981\u4f60\u8c26\u8ba9\uff1f\u613f\u8d4c\u670d\u8f93\uff0c\u8981\u4ec0\u4e48\u76f4\u8bf4\u3002\u201d",
    "\u867d\u7136\u8bdd\u8bed\u4ece\u5bb9\uff0c\u4f46\u773c\u795e\u6643\u6765\u6643\u53bb\uff0c\u660e\u663e\u6709\u70b9\u614c\u3002",
    "\u53f6\u884c\u6b4c\u89c1\u6b64\u6709\u4e9b\u597d\u7b11\uff0c\u51d1\u8fd1\u51e0\u5206\uff1a",
    "\u201c\u90a3\u6211\u771f\u8bf4\u4e86\uff1f\u201d",
    "\u201c\u8bf4\u5427\u3002\u201d",
    "\u201c\u6628\u5929\u8bf4\u597d\u4e86\u731c\u8c1c\uff0c\u6211\u7ed9\u63d0\u793a\uff0c\u6d1b\u59d0\u59d0\u731c\uff0c\u7136\u540e\u613f\u8d4c\u670d\u8f93\u3002\u82e5\u662f\u6d1b\u59d0\u59d0\u731c\u5bf9\u81ea\u7136\u6700\u597d\uff0c\u4f46\u731c\u9519\u7ed9\u9519\uff0c\u53ef\u4e0d\u80fd\u602a\u6211\u3002\u201d",
    "\u6d1b\u7384\u9752\u89c1\u662f\u8fd9\u79cd\u73a9\u6cd5\uff0c\u5fc3\u91cc\u53c8\u653e\u5fc3\u4e0d\u5c11\uff0c\u6d17\u8033\u606d\u542c\uff1a",
    "\u201c\u884c\uff0c\u82e5\u672c\u5b98\u731c\u9519\u767d\u7ed9\uff0c\u90a3\u81ea\u5df1\u4e0d\u4f1a\u602a\u4f60\u3002\u201d",
    "\u53f6\u884c\u6b4c\u70b9\u4e86\u70b9\u5934\uff0c\u7565\u5fae\u659f\u914c\uff1a",
    "\u201c\u55ef\u2026\u2026\u90a3\u79cd\u4e1c\u897f\uff0c\u53ea\u5728\u6211\u548c\u6d1b\u59d0\u59d0\u72ec\u5904\u65f6\uff0c\u6211\u5728\u6d1b\u59d0\u59d0\u8fd9\u91cc\u89c1\u8fc7\uff0c\u4e14\u662f\u6211\u957f\u8fd9\u4e48\u5927\u5934\u4e00\u6b21\u89c1\u3002\u60f3\u8d77\u6765\u6ca1\u6709\uff1f\u201d",
    "\u7b2c\u4e00\u6b21\u89c1\u2026\u2026",
    "\u53ea\u5728\u5979\u8fd9\u91cc\u2026\u2026",
    "\u6d1b\u7384\u9752\u770b\u8fc7\u53f6\u884c\u6b4c\u80cc\u666f\u5ba1\u67e5\uff0c\u77e5\u9053\u8fd9\u5c0f\u5b50\u6ca1\u8c08\u8fc7\u76f8\u597d\uff0c\u81ea\u7136\u4e5f\u6ca1\u89c1\u8fc7\u96ea\u5b50\u2026\u2026",
    "\u4f46\u6b64\u5b50\u62d0\u5f2f\u62b9\u89d2\u7684\uff0c\u603b\u4e0d\u80fd\u76f4\u63a5\u8bf4\u8fd9\u4e2a\u5427\uff1f",
    "\u201c\u8fd8\u6709\u63d0\u793a\u5417\uff1f\u201d",
    "\u53f6\u884c\u6b4c\u601d\u8003\u4e86\u4e0b\uff0c\u7ee7\u7eed\u9053\uff1a",
    "\u201c\u6211\u5f53\u65f6\u770b\u5230\u7684\u65f6\u5019\uff0c\u773c\u775b\u77aa\u7684\u8001\u5927\uff0c\u76f4\u52fe\u52fe\u76ef\u7740\u90a3\u6837\u4e1c\u897f\u3002\u201d",
    "\u201c\u8fd8\u6709\u5417\uff1f\u201d",
    "\u201c\u55ef\u2026\u2026\u5f53\u65f6\u770b\u7684\u5730\u65b9\uff0c\u662f\u5706\u7684\uff0c\u548c\u74f7\u5668\u4e00\u6837\u96ea\u767d\uff0c\u5165\u624b\u5e94\u8be5\u662f\u70ed\u7684\uff0c\u4e0d\u8fc7\u91cc\u9762\u6709\u65f6\u5019\u6709\u6c34\uff0c\u53ef\u4ee5\u559d\uff0c\u4f46\u5927\u90e8\u5206\u65f6\u5019\u6ca1\u6c34\u2026\u2026\u201d",
    "\u556a\u2014\u2014",
    "\u8bdd\u6ca1\u8bf4\u5b8c\uff0c\u6d1b\u7384\u9752\u8138\u8272\u5c31\u5316\u4e3a\u4e86\u6da8\u7ea2\uff0c\u8f7b\u62cd\u8336\u6848\uff1a",
    "\u201c\u4f60\u8fd8\u771f\u6562\u5f00\u53e3\uff1f\u672c\u5b98\u6253\u4f60\u677f\u5b50\u4fe1\u4e0d\u4fe1\uff1f\u201d",
    "\u53f6\u884c\u6b4c\u5fae\u5fae\u644a\u624b\uff0c\u7406\u76f4\u6c14\u58ee\uff1a",
    "\u201c\u6211\u53ef\u6ca1\u8bf4\u662f\u4ec0\u4e48\uff0c\u6d1b\u59d0\u59d0\u82e5\u731c\u9519\u4e86\u767d\u7ed9\uff0c\u6211\u53ef\u4ee5\u4e0d\u8981\uff0c\u4f46\u5565\u4e5f\u6ca1\u7ed9\uff0c\u5c31\u8bf4\u6211\u56fe\u8c0b\u4e0d\u8f68\uff0c\u6211\u53ef\u4e0d\u8ba4\u8d26\u3002\u201d",
    "\u6d1b\u7384\u9752\u89c9\u5f97\u8fd9\u5c31\u4e0d\u53ef\u80fd\u731c\u9519\u3002",
    "\u6bd5\u7adf\u53ea\u5728\u4e24\u4eba\u4e4b\u95f4\u89c1\u8fc7\uff0c\u53f6\u884c\u6b4c\u8fd8\u5f88\u9707\u60ca\u3001\u7b2c\u4e00\u6b21\u89c1\uff0c\u4e14\u662f\u5706\u7684\u3001\u96ea\u767d\u3001\u5165\u624b\u70ed\u4e4e\u4e4e\u3001\u91cc\u9762\u65f6\u800c\u6709\u5976\u3001\u65f6\u800c\u6ca1\u6709\u2026\u2026",
    "\u8fd9\u8fd8\u80fd\u662f\u4ec0\u4e48\uff1f",
    "\u8fd9\u81ed\u5c0f\u5b50\uff0c\u80af\u5b9a\u662f\u4e0d\u60f3\u76f4\u8bf4\uff0c\u6545\u610f\u62d0\u5f2f\u62b9\u89d2\u627e\u501f\u53e3\u2026\u2026",
    "\u4f46\u5979\u731c\u51fa\u6765\u5c31\u8981\u7ed9\uff0c\u4e0d\u7ed9\u5c31\u4e0d\u80fd\u51a4\u6789\u8fd9\u6b7b\u5c0f\u5b50\u2026\u2026",
    "\u6d1b\u7384\u9752\u6697\u6697\u54ac\u7259\u7247\u523b\uff0c\u5f80\u7a97\u5916\u96e8\u5e55\u770b\u4e86\u773c\u540e\uff0c\u62ac\u8896\u8f7b\u6325\uff0c\u5c31\u628a\u7a97\u6237\u5173\u4e0a\u4e86\u3002",
    "\u5494\u54d2~",
    "\u7ee7\u800c\u53c8\u505a\u51fa\u98ce\u8f7b\u4e91\u6de1\u7684\u5973\u4e0a\u53f8\u6a21\u6837\uff0c\u76c8\u76c8\u8d77\u8eab\u6765\u5230\u53f6\u884c\u6b4c\u8ddf\u524d\u5c31\u5750\uff0c\u7fd8\u8d77\u4e8c\u90ce\u817f\uff0c\u6446\u51fa\u653b\u51fb\u6027\u6781\u5f3a\u7684\u5fa1\u59d0\u59ff\u6001\uff1a",
    "\u201c\u8fd8\u88c5\u662f\u5427\uff1f\u6709\u672c\u4e8b\u4f60\u5c31\u6478\uff0c\u53cd\u6b63\u672c\u5b98\u731c\u7684\u5c31\u662f\u8fd9\u4e2a\uff0c\u4e8b\u540e\u4f60\u8981\u662f\u7b54\u6848\u4e0d\u4e00\u6837\uff0c\u8fd8\u80fd\u5bf9\u4e0a\uff0c\u90a3\u672c\u5b98\u5fc3\u670d\u53e3\u670d\u3002",
    "\u201c\u4f46\u4f60\u8981\u662f\u8bf4\u4e0d\u51fa\u5176\u4ed6\u7b54\u6848\uff0c\u53ef\u522b\u602a\u672c\u5b98\u5fc3\u72e0\u624b\u8fa3\uff01\u201d",
    "\u7a7a\u7075\u5f3a\u8c03\u770b\u4f3c\u5f3a\u52bf\uff0c\u4f46\u8bed\u6c14\u6709\u70b9\u865a\uff0c\u660e\u663e\u662f\u5728\u8d4c\u53f6\u884c\u6b4c\u4e0d\u6562\u4e0b\u624b\u3002",
    "\u53f6\u884c\u6b4c\u77a7\u89c1\u6d1b\u5927\u7f8e\u4eba\u63d0\u5fc3\u540a\u80c6\u7684\u6a21\u6837\uff0c\u6709\u4e9b\u65e0\u5948\uff1a",
    "\u201c\u6d1b\u59d0\u59d0\u518d\u597d\u597d\u60f3\u60f3\uff0c\u8fd9\u771f\u7ed9\u9519\uff0c\u6211\u53ef\u4e0d\u8d1f\u8d23\u3002\u201d",
    "\u6d1b\u7384\u9752\u53c8\u601d\u8003\u4e86\u4e0b\uff0c\u4f46\u600e\u4e48\u60f3\u90fd\u89c9\u5f97\u4e0d\u53ef\u80fd\u6709\u5176\u4ed6\u4e1c\u897f\uff0c\u8f7b\u54fc\u9053\uff1a",
    "\u201c\u4f60\u8981\u4e48\u6478\uff0c\u8981\u4e48\u8bf4\uff01\u672c\u5b98\u4e0d\u4fe1\u8fd8\u80fd\u662f\u5176\u4ed6\u4e1c\u897f\uff01\u201d",
    "\u53f6\u884c\u6b4c\u6447\u4e86\u6447\u5934\uff0c\u62ff\u8d77\u767d\u74f7\u8336\u7897\uff0c\u9012\u5230\u6d1b\u5927\u7f8e\u4eba\u9762\u524d\uff1a",
    "\u201c\u7b54\u6848\u8fd9\u4e48\u660e\u663e\uff0c\u6d1b\u59d0\u59d0\u90fd\u731c\u4e0d\u51fa\u6765\uff1f\u8fd8\u597d\u6211\u4e0d\u662f\u8272\u80da\uff0c\u4e0d\u7136\u4eca\u5929\u6d1b\u59d0\u59d0\u53ef\u5f97\u906d\u8001\u7f6a\u4e86\uff0c\u88ab\u767d\u6478\u8fd8\u4e0d\u5360\u7406\u2026\u2026\u201d",
    "\u201c\uff1f\u201d",
    "\u6d1b\u7384\u9752\u77a7\u89c1\u8336\u676f\uff0c\u8d77\u521d\u7565\u663e\u7591\u60d1\uff0c\u4f46\u5f88\u5feb\u53c8\u773c\u795e\u4e00\u50f5\uff0c\u60f3\u8d77\u6765\u4e86\u4e00\u4ef6\u4e8b\u60c5\uff01",
    "\u4e24\u4eba\u7b2c\u4e00\u6b21\u89c1\u9762\uff0c\u5f7c\u6b64\u5728\u5ba2\u6808\u5927\u5802\u72ec\u5904\u3002",
    "\u5979\u62ff\u7740\u8336\u676f\u5012\u8fc7\u6765\uff0c\u8868\u6f14\u2018\u9f99\u5438\u6c34\u2019\uff0c\u6b64\u5b50\u77aa\u5927\u773c\u775b\u60ca\u4e3a\u5929\u4eba\u2026\u2026",
    "\u7b2c\u4e00\u6b21\u89c1\u3001\u74f7\u5668\u4e00\u6837\u767d\u3001\u5706\u7684\u3001\u70ed\u7684\u3001\u6709\u6c34\u6ca1\u6c34\u2026\u2026",
    "\u201c\u2026\u2026\u201d",
    "\u6d1b\u7384\u9752\u9677\u5165\u6c89\u9ed8\uff0c\u8138\u8272\u9010\u6e10\u7ea2\u5230\u4e86\u8116\u5b50\u6839\uff0c\u618b\u4e86\u826f\u4e45\u540e\uff0c\u53c8\u67f3\u7709\u5012\u7ad6\uff1a",
    "\u201c\u4f60\u6545\u610f\u8bef\u5bfc\u672c\u5b98\u662f\u5427\uff1f\u4f60\u6478\u8fd9\u4e2a\u505a\u4ec0\u4e48\u5440\uff1f\u201d",
    "\u53f6\u884c\u6b4c\u7565\u5fae\u644a\u624b\uff1a",
    "\u201c\u559d\u9152\u73a9\u6e38\u620f\u6253\u8d4c\uff0c\u5c31\u662f\u5f97\u8ba9\u4eba\u5f80\u6b6a\u5904\u60f3\uff0c\u6211\u660e\u8bf4\u8fd8\u6709\u4ec0\u4e48\u610f\u601d\uff1f\u6d1b\u59d0\u59d0\u731c\u5bf9\u771f\u7ed9\u8fd9\u4e2a\uff0c\u6211\u53c8\u4e0d\u4f1a\u4e0d\u8ba4\uff0c\u7ed3\u679c\u4e00\u8fb9\u4e0d\u7ed9\uff0c\u4e00\u8fb9\u8bf4\u6211\u8272\u772f\u5fc3\u7a8d\uff0c\u5f53\u771f\u5bd2\u5fc3\u4e86\u2026\u2026\u201d",
    "\u201c\u4f60\u2026\u2026\u201d",
    "\u6d1b\u7384\u9752\u5f20\u4e86\u5f20\u5634\uff0c\u786c\u4e0d\u77e5\u9053\u600e\u4e48\u63a5\u8bdd\u4e86\u3002",
    "\u53f6\u884c\u6b4c\u5012\u4e86\u4e00\u7897\u8336\uff0c\u628a\u8336\u676f\u9001\u5230\u9762\u524d\uff1a",
    "\u201c\u597d\u5566\u597d\u5566\uff0c\u79c1\u4e0b\u91cc\u5f00\u73a9\u7b11\u7f62\u4e86\uff0c\u8fd9\u6b21\u4e0d\u7b97\uff0c\u54b1\u4eec\u518d\u8d4c\u4e00\u6b21\uff0c\u4e03\u5929\u8fdb\u524d\u4e09\u767e\uff01\u4e0d\u8fc7\u8fd9\u6b21\u5f97\u6362\u4e2a\u73a9\u6cd5\u2026\u2026\u8bf6\uff1f\u201d",
    "\u201c\u2026\u2026\u201d",
    "\u8bdd\u6ca1\u8bf4\u5b8c\uff0c\u5c31\u53d1\u73b0\u9762\u524d\u7684\u9752\u8863\u5927\u8d35\u5983\uff0c\u8138\u8272\u6da8\u7ea2\u773c\u795e\u4e00\u6a2a\uff0c\u63a5\u4f4f\u8336\u676f\u62cd\u5728\u8336\u6848\uff0c\u53c8\u6293\u4f4f\u4ed6\u7684\u53f3\u624b\u6441\u5728\u4e86\u5927\u5927\u7684\u826f\u5fc3\u4e0a\uff0c\u8bed\u6c14\u9887\u4e3a\u5f3a\u52bf\uff1a",
    "\u201c\u672c\u5b98\u9700\u8981\u4f60\u8ba9\uff1f\u6211\u731c\u7684\u5c31\u662f\u8fd9\u4e2a\uff0c\u6309\u7167\u89c4\u77e9\uff0c\u731c\u5230\u4ec0\u4e48\u5c31\u5f97\u7ed9\uff0c\u7ed9\u9519\u4e86\u4e0d\u602a\u4f60\uff0c\u672c\u5b98\u8bf4\u5230\u505a\u5230\uff0c\u5c82\u4f1a\u8a00\u800c\u65e0\u4fe1\uff1f\u201d",
    "\u7a7a\u7075\u55d3\u97f3\u5fae\u5fae\u53d1\u98a4\uff01",
    "\uff1f",
    "\u53f6\u884c\u6b4c\u4e00\u6123\uff0c\u4f4e\u5934\u626b\u4e86\u4e0b\uff0c\u89c9\u5f97\u6d1b\u5927\u7f8e\u4eba\u5f53\u771f\u6562\u4f5c\u6562\u5f53\u3002",
    "\u4e0d\u8fc7\u6309\u7167\u8d4c\u7ea6\uff0c\u5e94\u8be5\u662f\u6478\u2018\u89c1\u8fc7\u2019\u7684\u4e1c\u897f\uff0c\u8fd9\u9694\u7740\u8863\u670d\uff0c\u663e\u7136\u4e0d\u7b97\u6570\u2026\u2026",
    "\u800c\u6d1b\u7384\u9752\u5f3a\u6491\u5973\u4e0a\u53f8\u4eea\u6001\uff0c\u53d1\u73b0\u8fd9\u81ed\u5c0f\u5b50\u82e5\u6709\u6240\u601d\uff0c\u4e5f\u610f\u8bc6\u5230\u95ee\u9898\u6240\u5728\uff0c\u776b\u6bdb\u8f7b\u98a4\u6697\u6697\u54ac\u7259\uff0c\u53c8\u628a\u624b\u63e3\u8fdb\u6000\u91cc\u6696\u7740\uff1a",
    "\u201c\u73b0\u5728\u884c\u4e86\u5427\uff1f\u201d",
    "\u8bdd\u8bed\u4f9d\u65e7\u5f3a\u52bf\uff0c\u4f46\u80a9\u5934\u660e\u663e\u98a4\u4e86\u4e0b\u3002",
    "\u201c\u5443\u2026\u2026\u201d",
    "\u53f6\u884c\u6b4c\u5f20\u4e86\u5f20\u5634\uff0c\u638c\u5fc3\u6ee1\u6ee1\u5f53\u5f53\uff0c\u5ffd\u7136\u89c9\u5f97\u81ea\u5df1\u771f\u547d\u72af\u6843\u82b1\uff0c\u7231\u4e0a\u8fd9\u5bcc\u6709\u4e14\u6177\u6168\u7684\u59d0\u59d0\u4e86\uff01",
    "\u8fd9\u5c31\u662f\u6709\u5bb9\u4e43\u5927\u5417\u2026\u2026",
    "\u6c99\u6c99\u6c99~",
    "\u4e66\u623f\u5185\u5b89\u9759\u4e0b\u6765\uff0c\u53ea\u5269\u4e0b\u7a97\u5916\u7684\u7ec6\u5bc6\u96e8\u58f0\u3002",
    "\u6d1b\u7384\u9752\u52aa\u529b\u5f3a\u6491\u7740\u6c14\u52bf\uff0c\u4f46\u4e0d\u53ef\u601d\u8bae\u7684\u89e6\u611f\u4f20\u5230\u5fc3\u5934\uff0c\u5fc3\u8df3\u8fd8\u662f\u77ac\u95f4\u7206\u8868\u3002",
    "\u5982\u6b64\u7ef4\u6301\u4e00\u77ac\u540e\uff0c\u5c31\u614c\u614c\u5fd9\u5fd9\u628a\u624b\u62bd\u51fa\u6765\uff0c\u8f7b\u54ac\u4e0b\u5507\u6574\u7406\u8863\u895f\uff1a",
    "\u201c\u597d\u5566\uff01\u6069\u6028\u4e24\u6e05\uff01\u672c\u5b98\u4e0d\u6b20\u4f60\u7684\u3002\u201d",
    "\u201c\u5475\u5475\u2026\u2026\u201d",
    "\u53f6\u884c\u6b4c\u89c9\u5f97\u6d1b\u5927\u7f8e\u4eba\u5f53\u771f\u6709\u610f\u601d\uff0c\u7528\u5976\u9999\u5473\u7684\u624b\u5e2e\u5fd9\u5012\u8336\uff1a",
    "\u201c\u6211\u5176\u5b9e\u771f\u6ca1\u60f3\u8981\u8fd9\u4e2a\uff0c\u5c31\u662f\u9152\u684c\u4e0a\u5f00\u4e2a\u73a9\u7b11\u2026\u2026\u201d",
    "\u6d1b\u7384\u9752\u8138\u8272\u7ea2\u7684\u53d1\u7d2b\uff0c\u95fb\u58f0\u8e59\u7709\uff1a",
    "\u201c\u5f97\u4e86\u4fbf\u5b9c\u8fd8\u5356\u4e56\u662f\u5427\uff1f\u201d",
    "\u201c\u6ca1\u6709\uff0c\u597d\u5427\uff0c\u662f\u6211\u60f3\u8981\u2026\u2026\u201d",
    "\u201c\u54fc\uff01\u201d",
    "\u6d1b\u7384\u9752\u5fc3\u4e71\u5982\u9ebb\uff0c\u7ad9\u8d77\u8eab\u6765\uff0c\u672c\u60f3\u8ba9\u53f6\u884c\u6b4c\u51fa\u53bb\u529e\u4e8b\uff0c\u4f46\u8d70\u51fa\u51e0\u6b65\u53c8\u56de\u5934\uff1a",
    "\u201c\u672c\u5b98\u662f\u613f\u8d4c\u670d\u8f93\uff0c\u4f60\u522b\u778e\u60f3\uff0c\u82e5\u662f\u6562\u8bf4\u51fa\u53bb\u2026\u2026\u201d",
    "\u8896\u5b50\u91cc\u6478\u51fa\u98de\u5200\uff0c\u773c\u795e\u4e0a\u4e0b\u6253\u91cf\u3002",
    "\u53f6\u884c\u6b4c\u4e5f\u8ddf\u7740\u8d77\u8eab\uff0c\u5fae\u5fae\u644a\u624b\uff1a",
    "\u201c\u8fd9\u79cd\u4e8b\uff0c\u6211\u600e\u4e48\u6562\u4e71\u8bf4\u3002\u55ef\u2026\u2026\u6211\u73b0\u5728\u5df2\u7ecf\u91d1\u699c\u9898\u540d\uff0c\u63a5\u4e0b\u6765\u662f\u4e0d\u662f\u5f97\u5c55\u73b0\u2018\u51b2\u52bf\u2019\uff1f\u201d"
  ]
}